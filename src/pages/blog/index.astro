---
import { getPosts, getFeaturedPosts } from '../../lib/fetchers';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import BlogCard from '../../components/BlogCard.astro';
import { Particles } from '../../components/Particles';
import { Icon } from 'astro-icon/components';

const posts = await getPosts();
const featuredPosts = await getFeaturedPosts();
---

<Layout title="Blog" description="Things I learn, break and build, written down so I don't forget them.">
	<Section class="pt-36 pb-24 flex flex-col gap-14">
		<div>
			<h1 class="font-display text-5xl sm:text-6xl md:text-8xl leading-[0.95] tracking-[-0.04em]">
				<span class="font-gradient">Blog</span>
			</h1>
			<p class="mt-6 max-w-lg leading-relaxed text-foreground/60 md:text-lg">
				Things I learn, break and build, written down so I don't forget them.
				<a
					href="/rss.xml"
					class="inline-flex items-center gap-1 ml-1 text-foreground/70 hover:text-foreground transition-colors"
				>
					<Icon name="tabler:rss" size={14} />
					RSS
				</a>
			</p>
		</div>
		{
			featuredPosts.length > 0 && (
				<div class="flex flex-col gap-7">
					<h2 class="flex items-center gap-5 font-display text-3xl md:text-4xl tracking-tight">
						<span>Featured posts</span>
						<span class="flex-1 h-px bg-linear-to-r from-border to-transparent" aria-hidden="true" />
					</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						{featuredPosts.map(post => (
							<BlogCard {...post} />
						))}
					</div>
				</div>
			)
		}
		{
			posts.length > 0 && (
				<div class="flex flex-col gap-7">
					<h2 class="flex items-center gap-5 font-display text-3xl md:text-4xl tracking-tight">
						<span>Other posts</span>
						<span class="flex-1 h-px bg-linear-to-r from-border to-transparent" aria-hidden="true" />
					</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
						{posts.map(post => (
							<BlogCard {...post} />
						))}
					</div>
				</div>
			)
		}
	</Section>
	<div class="w-full max-w-160 h-40 relative self-center mask-[radial-gradient(at_bottom,white_20%,transparent)]">
		<Particles client:visible theme="auto" minSize={0.4} maxSize={1} particleDensity={100} className="w-full h-full" />
	</div>
</Layout>
