---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Anchor from '../../components/Anchor.astro';
import { formatDate } from '../../lib/utils';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map(post => ({
		params: { slug: post.id },
		props: post
	}));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const slug = Astro.params.slug;
const { Content } = await render(post);

if (!slug || !post) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const { title, description, pubDate, updatedDate, heroImage, heroImageAlt } = Astro.props.data;
---

<Layout title={title} description={description}>
	<div class="relative container max-w-(--breakpoint-md) pt-32 pb-20">
		<article class="max-w-none">
			<Anchor variant="outline" size="sm" href="/blog" class="group">
				<Icon name="tabler:arrow-left" size={14} class="mr-1.5 transition-transform group-hover:-translate-x-0.5" />
				Blog
			</Anchor>
			<div class="flex items-center w-full mt-10">
				<code class="text-sm text-foreground/60" transition:name={`date-${slug}`}>
					<time datetime={pubDate.toDateString()}>
						{formatDate(pubDate)}
					</time>
					{
						updatedDate && (
							<span>
								· Last updated on <time datetime={updatedDate.toDateString()}>{formatDate(updatedDate)}</time>
							</span>
						)
					}
				</code>
			</div>
			<h1
				class="mt-4 font-display font-gradient text-4xl md:text-6xl leading-[1.02] tracking-[-0.035em] text-balance pb-1"
				transition:name={`title-${slug}`}
			>
				{title}
			</h1>
			<p class="mt-5 max-w-2xl text-lg md:text-xl leading-relaxed text-foreground/60 text-pretty">
				{description}
			</p>

			<Image
				loading="eager"
				class="w-full h-full object-cover rounded-3xl corner-superellipse-[1.4] overflow-hidden aspect-video border mt-12 mb-12"
				width={720}
				height={360}
				src={heroImage}
				alt={heroImageAlt}
				transition:name={`img-${post.id}`}
			/>
			<div
				class="prose dark:prose-invert prose-headings:font-display prose-headings:tracking-tight prose-a:text-foreground prose-a:underline-offset-4 prose-img:rounded-2xl prose-img:border prose-pre:rounded-2xl prose-pre:border prose-code:before:content-none prose-code:after:content-none"
			>
				<Content />
			</div>
		</article>
	</div>
</Layout>
