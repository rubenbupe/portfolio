---
import { cn } from '../lib/utils';
import { cva, type VariantProps } from 'class-variance-authority';
import type { HTMLAttributes } from 'astro/types';

export const buttonVariants = cva(
	'inline-flex items-center justify-center whitespace-nowrap rounded-xl text-sm font-medium transition-colors focus-visible:outline-hidden focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 active:shadow-[inset_0_2px_4px_rgba(0,0,0,0.1)] corner-superellipse-[1.4]',
	{
		variants: {
			variant: {
				default:
					'text-primary-foreground bg-linear-to-b dark:bg-linear-to-t from-primary/75 to-primary hover:opacity-95 backdrop-blur-md dark:shadow-[inset_0px_1px_1px_rgba(255,255,255,0.3),inset_0px_-1.5px_2px_rgba(0,0,0,0.3)] shadow-[inset_0px_1px_1px_rgba(0,0,0,0.3),inset_0px_-1.5px_2px_rgba(255,255,255,0.3)]',
				outline:
					'border border-foreground/30 outline-solid outline-[1px] outline-background/50 shadow-xs hover:bg-card bg-card/50',
				ghost: 'hover:bg-primary hover:text-primary-foreground active:shadow-none',
				link: 'text-primary underline-offset-4 hover:underline'
			},
			size: {
				default: 'h-10 px-4 py-2',
				sm: 'h-9 rounded-xl px-3.5 text-[13px]',
				lg: 'h-12 rounded-[14px] px-6 text-[15px]',
				icon: 'h-10 w-10'
			}
		},
		defaultVariants: {
			variant: 'default',
			size: 'default'
		}
	}
);

interface Props extends HTMLAttributes<'button'>, VariantProps<typeof buttonVariants> {}

const { class: className, variant, size, ...rest } = Astro.props;
---

<button class={cn(buttonVariants({ variant, size, className }))} {...rest}>
	<slot />
</button>
