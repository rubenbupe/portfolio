---
import { formatDate } from '../lib/utils';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Pin3d from './Pin3d.astro';

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
---

<Pin3d
	title="Click to read more"
	href={`/blog/${post.id}/`}
	containerClassName="w-full"
	className="w-full rounded-3xl corner-superellipse-[1.4] border card-surface overflow-hidden group-hover/pin:border-foreground/30 transition-all"
>
	<article class="w-full flex flex-col h-full">
		<div class="relative aspect-video overflow-hidden border-b bg-background">
			<Image
				loading="eager"
				class="w-full h-full object-cover filter grayscale group-hover/pin:grayscale-0 transition-all duration-700 group-hover/pin:scale-104"
				width={720}
				height={360}
				src={post.data.heroImage}
				alt={post.data.heroImageAlt}
				transition:name={`img-${post.id}`}
			/>
		</div>
		<div class="flex flex-col flex-1 p-6">
			<span class="font-medium text-foreground/60 text-xs" transition:name={'date-' + post.id}>
				<code>{formatDate(post.data.pubDate)}</code>
			</span>
			<h3
				class="mt-2.5 font-display text-2xl leading-tight tracking-tight line-clamp-3 text-balance"
				transition:name={'title-' + post.id}
			>
				{post.data.title}
			</h3>
			<p class="mt-2.5 text-sm text-foreground/60 leading-relaxed line-clamp-3">{post.data.description}</p>
			<span class="inline-flex items-center gap-1.5 mt-auto pt-5 text-sm font-medium text-foreground/70">
				Read post
				<Icon name="tabler:arrow-right" size={14} class="transition-transform group-hover/pin:translate-x-0.5" />
			</span>
		</div>
	</article>
	<div
		class="absolute -inset-2 pointer-events-none rounded-3xl corner-superellipse-[1.4] group-hover/pin:backdrop-blur-sm transition-all duration-500 mask-[linear-gradient(to_top,transparent,black)]"
	>
	</div>
</Pin3d>
