---
import { cn } from '../lib/utils';
import Button from './Button.astro';
import { Icon } from 'astro-icon/components';
import { mailUrl, githubUrl, linkedinUrl, links } from '../constants/site';
import Anchor from './Anchor.astro';

type Props = {
	class?: string;
};

const { class: className } = Astro.props;
---

<script>
	// Scroll events can be expensive, it is recommended to change them once
	// scroll css animations are supported for most users.
	// https://caniuse.com/mdn-css_properties_animation-timeline_scroll

	const setupHandler = () => {
		const headerContainer = document.querySelector('#header-container');
		if (!headerContainer) return;

		let isScrolled = false;
		const handleScroll = () => {
			const shouldBeScrolled = window.scrollY > 50;
			if (shouldBeScrolled === isScrolled) return;
			headerContainer.classList.toggle('scrolled', shouldBeScrolled);
			isScrolled = shouldBeScrolled;
		};

		window.addEventListener('scroll', handleScroll, { passive: true });
		document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', handleScroll), {
			once: true
		});
		handleScroll();
	};

	document.addEventListener('astro:page-load', () => {
		setupHandler();
	});
</script>
<script>
	// Sliding pill behind the hovered link, resting on the section currently in view
	const setupNavPill = () => {
		const nav = document.querySelector<HTMLElement>('#header-links');
		const pill = document.querySelector<HTMLElement>('#header-pill');
		if (!nav || !pill) return;

		const navLinks = [...nav.querySelectorAll<HTMLAnchorElement>('a[data-nav]')];

		const moveTo = (link: HTMLElement | null) => {
			if (!link) {
				pill.style.opacity = '0';
				return;
			}
			pill.style.width = `${link.offsetWidth}px`;
			pill.style.transform = `translateX(${link.offsetLeft}px)`;
			pill.style.opacity = '1';
		};

		const activeLink = () => navLinks.find(link => link.classList.contains('active')) ?? null;

		navLinks.forEach(link => link.addEventListener('mouseenter', () => moveTo(link)));
		nav.addEventListener('mouseleave', () => moveTo(activeLink()));

		const sections = navLinks
			.map(link => document.getElementById(link.dataset.nav ?? ''))
			.filter((section): section is HTMLElement => !!section);

		const observer = new IntersectionObserver(
			entries => {
				entries.forEach(entry => {
					if (!entry.isIntersecting) return;
					navLinks.forEach(link => link.classList.toggle('active', link.dataset.nav === entry.target.id));
					if (!nav.matches(':hover')) moveTo(activeLink());
				});
			},
			{ rootMargin: '-45% 0px -50% 0px' }
		);

		sections.forEach(section => observer.observe(section));
		document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
	};

	document.addEventListener('astro:page-load', () => {
		setupNavPill();
	});
</script>
<script>
	document.addEventListener('astro:page-load', () => {
		const navbarToggle = document.getElementById('mobile-navbar-toggle');
		const mobileNavbar = document.getElementById('mobile-navbar');

		const setMobileNavbar = (open: boolean) => {
			mobileNavbar?.classList.toggle('hidden', !open);
			navbarToggle?.setAttribute('aria-expanded', String(open));
		};

		navbarToggle?.addEventListener('click', () => {
			setMobileNavbar(mobileNavbar?.classList.contains('hidden') ?? false);
		});

		document.querySelectorAll('#mobile-navbar a').forEach(link => {
			link.addEventListener('click', () => setMobileNavbar(false));
		});

		document.addEventListener('keydown', event => {
			if (event.key === 'Escape') setMobileNavbar(false);
		});
	});
</script>

<div
	id="header-container"
	class={cn(
		'group/header w-full sticky top-0 self-center flex flex-col px-4 md:px-6 transition-[padding] duration-500 ease-(--ease-out-expo) [&.scrolled]:pt-3',
		className
	)}
>
	<header
		class={cn(
			'relative mx-auto w-full max-w-6xl h-16 flex items-center px-2 md:px-6 border border-transparent rounded-2xl corner-superellipse-[1.4]',
			'transition-[max-width,height,background-color,border-color,box-shadow,padding] duration-500 ease-(--ease-out-expo)',
			"after:content-[''] after:absolute after:inset-x-0 after:-bottom-px after:h-px after:bg-linear-to-r after:from-transparent after:via-border after:to-transparent after:transition-opacity",
			'group-[.scrolled]/header:max-w-[880px] group-[.scrolled]/header:h-14 group-[.scrolled]/header:px-2 group-[.scrolled]/header:pl-4',
			'group-[.scrolled]/header:bg-white/70 dark:group-[.scrolled]/header:bg-[rgb(20_21_24/0.62)] group-[.scrolled]/header:border-border group-[.scrolled]/header:backdrop-blur-[18px] group-[.scrolled]/header:backdrop-saturate-160',
			'group-[.scrolled]/header:shadow-[0_20px_50px_-20px_rgba(0,0,0,0.6),inset_0_1px_0_rgba(255,255,255,0.05)] group-[.scrolled]/header:after:opacity-0'
		)}
	>
		<nav class="relative flex w-full gap-4 items-center">
			<Anchor href="#main" size="sm" class="absolute left-[-100vw] opacity-0 focus:opacity-100 focus:left-0">
				Skip to main content</Anchor
			>
			<a class="inline-flex items-center text-lg tracking-tight font-semibold text-foreground" href="/#home">
				<span class="text-foreground/70 mr-1 font-light">/</span>rubenbupe
			</a>

			<div id="header-links" class="absolute left-1/2 -translate-x-1/2 hidden md:flex items-center gap-0.5">
				<span
					id="header-pill"
					class="absolute top-0 left-0 h-full rounded-[10px] corner-superellipse-[1.4] bg-foreground/8 dark:bg-foreground/15 opacity-0 pointer-events-none transition-[transform,width,opacity] duration-500 ease-(--ease-out-expo)"
					aria-hidden="true"></span>
				{
					links.map(link => (
						<a
							class="relative inline-flex items-center gap-0.5 px-3 py-1.5 rounded-[10px] text-sm text-foreground/60 hover:text-foreground [&.active]:text-foreground transition-colors whitespace-nowrap"
							href={link.href}
							target={link.external ? '_blank' : '_self'}
							data-nav={link.href.startsWith('/#') ? link.href.slice(2) : undefined}
						>
							{link.text}
							{!!link.external && <Icon name="tabler:arrow-up-right" size={12} class="opacity-60" />}
						</a>
					))
				}
			</div>

			<div class="hidden md:flex items-center gap-2 ml-auto">
				<Anchor class="p-2 w-9" size="sm" variant="outline" href={linkedinUrl} target="_blank" aria-label="LinkedIn"
					><Icon name="tabler:brand-linkedin" size={18} />
					<span class="sr-only">LinkedIn</span>
				</Anchor>

				<Anchor class="p-2 w-9" size="sm" variant="outline" href={githubUrl} target="_blank" aria-label="Github"
					><Icon name="tabler:brand-github" size={18} />
					<span class="sr-only">Github</span>
				</Anchor>

				<Anchor size="sm" href={mailUrl} target="_blank" aria-label="Contact" data-magnetic>
					<Icon name="tabler:mail" size={18} class="block lg:hidden" />
					<span class="hidden lg:block">Contact</span>
				</Anchor>
			</div>

			<Button
				id="mobile-navbar-toggle"
				class="group/toggle flex ml-auto md:hidden p-2 w-9"
				aria-label="Open mobile navigation"
				aria-controls="mobile-navbar"
				aria-expanded="false"
				size="sm"
				variant="outline"
			>
				<Icon name="tabler:menu" size={18} class="group-aria-expanded/toggle:hidden" />
				<Icon name="tabler:x" size={18} class="hidden group-aria-expanded/toggle:block" />
			</Button>
		</nav>
	</header>
	<!-- Outside <header> so its backdrop blur never nests inside the header one -->
	<nav
		id="mobile-navbar"
		class="hidden md:hidden! absolute inset-x-4 md:inset-x-6 top-[calc(100%+10px)] p-3.5 flex flex-col rounded-3xl corner-superellipse-[1.4] border bg-white/70 dark:bg-[rgb(20_21_24/0.62)] backdrop-blur-[24px] backdrop-saturate-160 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.7)] animate-[drop_0.45s_var(--ease-out-expo)]"
	>
		{
			links.map((link, index) => (
				<a
					class="flex items-center justify-between px-2.5 py-3 border-b font-display text-3xl tracking-tight text-foreground animate-[drop_0.5s_var(--ease-out-expo)_both]"
					style={`animation-delay: ${index * 40}ms`}
					href={link.href}
					target={link.external ? '_blank' : '_self'}
				>
					{link.text}
					{!!link.external && <Icon name="tabler:arrow-up-right" size={20} class="opacity-50" />}
				</a>
			))
		}
		<div class="flex flex-wrap gap-2 pt-3.5">
			<Anchor size="sm" variant="outline" href={linkedinUrl} target="_blank">
				<Icon name="tabler:brand-linkedin" size={16} class="mr-2" />LinkedIn
			</Anchor>
			<Anchor size="sm" variant="outline" href={githubUrl} target="_blank">
				<Icon name="tabler:brand-github" size={16} class="mr-2" />GitHub
			</Anchor>
			<Anchor size="sm" href={mailUrl} target="_blank">
				<Icon name="tabler:mail" size={16} class="mr-2" />Email
			</Anchor>
		</div>
	</nav>
</div>

<style is:global>
	@keyframes drop {
		from {
			opacity: 0;
			transform: translateY(-8px);
		}
	}
</style>
