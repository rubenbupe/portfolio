---
import { Icon } from 'astro-icon/components';
import ConicHeader from '../components/ConicHeader.astro';
import { ExpandableHoloJobCards } from '../components/ExpandableHoloJobCards';
import JobsTimeline from '../components/JobsTimeline.astro';
import { Particles } from '../components/Particles';
import Section from '../components/Section.astro';
---

<div class="relative w-full flex flex-col">
	<ConicHeader color="hsla(var(--conic-background))" borderColor="hsla(var(--conic-border))" />
	<div
		class="w-full max-w-160 h-40 relative self-center mask-[radial-gradient(350px_200px_at_top,white_20%,transparent)]"
	>
		<Particles client:visible theme="auto" minSize={0.4} maxSize={1} particleDensity={100} className="w-full h-full" />
	</div>
	<Section id="jobs" class="relative py-24 min-h-[90vh] flex flex-col" zoomEffect>
		<h2 class="font-display text-4xl sm:text-5xl md:text-7xl leading-[0.98] tracking-[-0.03em]" data-reveal>
			<span class="font-gradient">Places I've built at.</span>
		</h2>
		<p class="mt-6 max-w-lg leading-relaxed text-foreground/60 md:text-lg" data-reveal style="--reveal-delay: 1">
			Since 2019 I've been shipping across the whole stack, often for more than one team at a time. Click on the cards
			to learn more about the places I've worked at, and a little bit about what I did there.
		</p>

		<JobsTimeline class="mt-14 md:mt-20" />

		<ExpandableHoloJobCards client:idle listClassName="mt-8">
			<Icon name="tabler:chevron-right" slot="bullet" class="mt-1 flex-none" />
		</ExpandableHoloJobCards>
	</Section>
</div>
