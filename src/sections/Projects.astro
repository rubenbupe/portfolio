---
import Section from '../components/Section.astro';
import ConicHeader from '../components/ConicHeader.astro';
import { Particles } from '../components/Particles';
import { Icon } from 'astro-icon/components';
import { cn } from '../lib/utils';
import projectGabinsoftDashboard from '../assets/project-gabinsoft-dashboard.webp';
import projectMeAsesoranRentas from '../assets/project-measesoran-rentas.webp';
import projectSeniorLauncher from '../assets/project-senior-launcher.webp';
import projectBuildingRoofDetection from '../assets/project-building-roof-detection.webp';
import projectGabinsoftLanding from '../assets/project-gabinsoft-landing.webp';
import projectFacialExpressionRecognition from '../assets/project-facial-expression-recognition.webp';
import projectFerropanel from '../assets/project-ferropanel.webp';
import projectRecipeAIVideoParser from '../assets/project-recipe-ai-video-parser.webp';
import { Image } from 'astro:assets';
import { githubUrl } from '../constants/site';

const projects = [
	{
		title: 'Gabinsoft',
		paragraphs: [
			'Gabinsoft is a company specialized in building tools for psychologists. I developed the full-stack web and mobile applications, as well as the backend services.',
			'These apps include a complete CRM, billing system, calendar, real-time chat, video calls, and more.'
		],
		badges: ['TypeScript', 'Go', 'React', 'React Native', 'SQL'],
		url: 'https://app.gabinsoft.com',
		image: projectGabinsoftDashboard,
		feature: true
	},
	{
		title: 'Me Asesoran Rentas',
		paragraphs: [
			'Me Asesoran Rentas is an app that helps users file their tax returns. I developed the backend services, web and mobile apps, and review tools.',
			'This project integrates several government APIs and is used by thousands of people every year.'
		],
		badges: ['TypeScript', 'React', 'React Native', 'SQL', 'Gov APIs'],
		url: 'https://rentas.measesoran.com',
		image: projectMeAsesoranRentas,
		feature: true
	},
	{
		title: 'Ferropanel',
		paragraphs: [
			'Ferropanel is an open-source visual configurator for ADIF station dashboards, built after reverse engineering the original QR-based system.',
			'It generates fully customizable panel URLs and includes a custom React wrapper connected directly to the original real-time data WebSocket.'
		],
		badges: ['TypeScript', 'React', 'TailwindCSS', 'Shadcn UI', 'WebSocket'],
		url: 'https://ferropanel.rubenbupe.com',
		image: projectFerropanel,
		feature: true
	},
	{
		title: 'Senior Android Launcher',
		paragraphs: [
			"Senior Launcher is an Android launcher app designed for older users, with a simplified interface, visual accessibility, and optional remote control through a backend. Inspired by the iPhone Guided Access mode, I developed it for my grandmother and some of my friends' grandmothers, who use it daily."
		],
		badges: ['Kotlin', 'Android', 'Jetpack Compose', 'AI Assisted'],
		url: 'https://github.com/rubenbupe/senior-launcher',
		image: projectSeniorLauncher,
		feature: false
	},
	{
		title: 'Gabinsoft landing & website',
		paragraphs: [
			"A marketing site with a hero inspired by Linear's, built with Astro, TailwindCSS and TypeScript focusing on performance, SEO and accessibility. Later wired to a headless CMS with a custom caching layer so the marketing team ships without developer intervention."
		],
		badges: ['TypeScript', 'Astro', 'TailwindCSS', 'Strapi'],
		url: 'https://gabinsoft.com',
		image: projectGabinsoftLanding,
		feature: false
	},
	{
		title: 'Recipe AI video parser',
		paragraphs: [
			'An API that parses cooking videos to extract structured recipe data: ingredients, quantities, and step-by-step instructions. I use it with iOS Shortcuts to automatically save recipes from social media videos to my recipe manager app.'
		],
		badges: ['Golang', 'Typescript', 'AI', 'Gemini'],
		url: 'https://github.com/rubenbupe/recipe-video-parser',
		image: projectRecipeAIVideoParser,
		feature: false
	},
	{
		title: 'Facial expression recognition',
		paragraphs: [
			'One of my final university projects: a system capable of detecting facial expressions in real time using a webcam. Built with TensorFlow and OpenCV, it detects 3 expressions with 86% accuracy, or 5 with 74%. It received an honorable mention.'
		],
		badges: ['Python', 'TensorFlow', 'OpenCV'],
		url: 'https://github.com/rubenbupe/facial-expressions-detector',
		image: projectFacialExpressionRecognition,
		feature: false
	},
	{
		title: 'Building roof detection',
		paragraphs: [
			"Also a final university project: a system that detects building roofs in satellite images, deployed as a real microservices architecture (web app, image-processing backend, analytics service) with a CI/CD pipeline to Kubernetes. It earned me a job offer from my professor's company, which I declined to pursue my own projects."
		],
		badges: ['Python', 'React', 'Docker', 'Kubernetes', 'MongoDB', 'TensorFlow', 'Github Actions'],
		url: 'https://github.com/rubenbupe/building-roof-detection',
		image: projectBuildingRoofDetection,
		imageFit: 'contain',
		feature: false
	}
];

const featuredProjects = projects.filter(project => project.feature);
const otherProjects = projects.filter(project => !project.feature);

const host = (url: string) => new URL(url).host;
---

<div class="relative w-full flex flex-col overflow-hidden">
	<ConicHeader color="hsla(var(--conic-background))" borderColor="hsla(var(--conic-border))" />
	<div
		class="w-full max-w-160 h-40 relative self-center mask-[radial-gradient(350px_200px_at_top,white_20%,transparent)]"
	>
		<Particles client:visible theme="auto" minSize={0.4} maxSize={1} particleDensity={100} className="w-full h-full" />
	</div>
	<Section id="projects" class="relative py-24 min-h-[90vh] flex flex-col" zoomEffect>
		<h2 class="font-display text-4xl sm:text-5xl md:text-7xl leading-[0.98] tracking-[-0.03em]" data-reveal>
			<span class="font-gradient">Things I've shipped.</span>
		</h2>
		<p class="mt-6 max-w-lg leading-relaxed text-foreground/60 md:text-lg" data-reveal style="--reveal-delay: 1">
			Products used by thousands of people, open-source tools and a few experiments I built because I was curious.
		</p>

		<div class="grid gap-5 mt-14 md:mt-20">
			{
				featuredProjects.map((project, index) => (
					<article
						class={cn(
							'card-surface card-spotlight group grid md:grid-cols-[0.9fr_1.1fr] md:min-h-130 rounded-3xl corner-superellipse-[1.4] border overflow-hidden',
							index % 2 === 1 && 'md:grid-cols-[1.1fr_0.9fr]'
						)}
						data-reveal
					>
						<div class={cn('flex flex-col items-start p-7 md:p-12', index % 2 === 1 && 'md:order-2')}>
							<h3 class="font-display text-4xl md:text-5xl leading-none tracking-[-0.035em]">{project.title}</h3>
							{project.paragraphs.map((paragraph, paragraphIndex) => (
								<p
									class={cn(
										'mt-4 max-w-md leading-relaxed',
										paragraphIndex === 0 ? 'text-foreground/80 md:text-lg' : 'text-foreground/60'
									)}
								>
									{paragraph}
								</p>
							))}
							<div class="flex gap-1.5 mt-5 flex-wrap">
								{project.badges.map(badge => (
									<code class="text-[11.5px] leading-none px-2 py-1.5 rounded-lg border border-foreground/12 bg-foreground/4 text-foreground/85">
										{badge}
									</code>
								))}
							</div>
							<a
								href={project.url}
								target="_blank"
								class="mt-auto pt-7 inline-flex items-center gap-2 text-sm font-medium after:content-[''] after:absolute after:inset-0"
							>
								<span class="border-b border-foreground/30 group-hover:border-foreground transition-colors">
									{host(project.url)}
								</span>
								<Icon
									name="tabler:arrow-up-right"
									size={16}
									class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
								/>
							</a>
						</div>

						<div
							class={cn(
								'relative perspective-[1600px] pt-12 max-md:pl-7 max-md:h-75 pointer-events-none',
								index % 2 === 1 ? 'md:pr-12' : 'md:pl-12'
							)}
							aria-hidden="true"
						>
							<div
								class={cn(
									'relative h-full md:min-h-95 overflow-hidden border border-b-0 bg-background transition-transform duration-1000 ease-(--ease-out-expo) group-hover:transform-none',
									index % 2 === 1
										? 'md:rounded-tr-xl md:border-l-0 md:origin-bottom-right md:transform-[rotateY(8deg)_rotateX(4deg)_translate3d(-24px,12px,0)] md:shadow-[30px_20px_80px_-20px_rgba(0,0,0,0.6)]'
										: 'rounded-tl-xl border-r-0 md:origin-bottom-left md:transform-[rotateY(-8deg)_rotateX(4deg)_translate3d(24px,12px,0)] md:shadow-[-30px_20px_80px_-20px_rgba(0,0,0,0.6)]'
								)}
							>
								<div class="flex items-center gap-3.5 h-9 px-3.5 border-b bg-card">
									<span class="inline-flex gap-1.5 [&>i]:size-2.5 [&>i]:rounded-full [&>i]:bg-foreground/20 [&>i]:transition-colors group-hover:[&>i:nth-child(1)]:bg-[#ff5f57] group-hover:[&>i:nth-child(2)]:bg-[#febc2e] group-hover:[&>i:nth-child(3)]:bg-[#28c840]">
										<i />
										<i />
										<i />
									</span>
									<code class="text-[11.5px] text-foreground/70 px-2.5 py-0.5 rounded-md bg-foreground/5">
										{host(project.url)}
									</code>
								</div>
								<Image
									src={project.image}
									alt={project.title}
									class={cn(
										'w-full h-[calc(100%-36px)] object-cover',
										index % 2 === 1 ? 'object-right-top' : 'object-left-top'
									)}
								/>
							</div>
						</div>
					</article>
				))
			}
		</div>

		<div class="flex items-center gap-5 mt-20 md:mt-28 mb-7" data-reveal>
			<h3 class="font-display text-3xl md:text-4xl tracking-tight whitespace-nowrap">More projects</h3>
			<span class="flex-1 h-px bg-linear-to-r from-border to-transparent" aria-hidden="true"></span>
		</div>

		<div class="relative grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-4">
			{
				otherProjects.map((project, index) => (
					<a
						href={project.url}
						target="_blank"
						class={cn(
							'card-surface card-spotlight group flex flex-col rounded-3xl corner-superellipse-[1.4] border transition-transform duration-500 ease-(--ease-out-expo) hover:-translate-y-1',
							index === 0 ? 'lg:col-span-4' : 'lg:col-span-2'
						)}
						data-reveal
						style={`--reveal-delay: ${index % 3}`}
					>
						<div
							class={cn(
								'relative aspect-video overflow-hidden rounded-t-[calc(var(--radius-3xl)-1px)] corner-superellipse-[1.4] border-b bg-background after:content-[""] after:absolute after:inset-0 after:opacity-75 after:bg-linear-to-t after:from-card after:to-transparent after:to-45%',
								index === 0 && 'md:aspect-21/9',
								project.imageFit === 'contain' && 'bg-white'
							)}
						>
							<Image
								src={project.image}
								alt={project.title}
								class={cn(
									'w-full h-full object-top transition-all duration-1000 ease-(--ease-out-expo) saturate-90 group-hover:saturate-100 group-hover:scale-104',
									project.imageFit === 'contain' ? 'object-contain p-3.5' : 'object-cover'
								)}
							/>
						</div>
						<div class="flex flex-col flex-1 p-6">
							<h4 class="flex items-center justify-between gap-3 font-display text-2xl tracking-tight leading-tight">
								{project.title}
								<span
									class="grid place-items-center size-7.5 flex-none rounded-full border text-foreground/60 transition-all duration-500 ease-(--ease-out-expo) group-hover:rotate-45 group-hover:bg-foreground group-hover:text-background group-hover:border-foreground"
									aria-hidden="true"
								>
									<Icon name="tabler:arrow-up-right" size={16} />
								</span>
							</h4>
							{project.paragraphs.map(paragraph => (
								<p class="mt-2.5 mb-4 text-sm leading-relaxed text-foreground/60">{paragraph}</p>
							))}
							<div class="flex gap-1.5 mt-auto flex-wrap">
								{project.badges.map(badge => (
									<code class="text-[11.5px] leading-none px-2 py-1.5 rounded-lg border border-foreground/12 bg-foreground/4 text-foreground/85">
										{badge}
									</code>
								))}
							</div>
						</div>
					</a>
				))
			}

			<a
				href={githubUrl}
				target="_blank"
				class="card-surface card-spotlight group grid md:grid-cols-[1fr_1.15fr] md:col-span-2 lg:col-span-6 rounded-3xl corner-superellipse-[1.4] border"
				data-reveal
			>
				<div class="flex flex-col p-7">
					<h4 class="flex items-center justify-between gap-3 font-display text-2xl tracking-tight leading-tight">
						Other projects
						<span
							class="grid place-items-center size-7.5 flex-none rounded-full border text-foreground/60 transition-all duration-500 ease-(--ease-out-expo) group-hover:rotate-45 group-hover:bg-foreground group-hover:text-background group-hover:border-foreground"
							aria-hidden="true"
						>
							<Icon name="tabler:arrow-up-right" size={16} />
						</span>
					</h4>
					<p class="mt-2.5 mb-4 text-sm leading-relaxed text-foreground/60">
						I've shared several open-source and side projects over the years, and I plan to keep building in public.
						Some examples include some utilities that I built for myself, React Navigation utilities, ML/AI experiments,
						and a Twitter client for Bash.
					</p>
					<div class="flex gap-1.5 mt-auto flex-wrap">
						{
							['TypeScript', 'React Native', 'Python', 'Bash', 'AI', 'ML'].map(badge => (
								<code class="text-[11.5px] leading-none px-2 py-1.5 rounded-lg border border-foreground/12 bg-foreground/4 text-foreground/85">
									{badge}
								</code>
							))
						}
					</div>
				</div>
				<div
					class="m-5 md:ml-0 rounded-2xl corner-superellipse-[1.4] border border-white/10 bg-[#060708] text-[#c9d1d9] overflow-hidden text-[13px] max-md:text-xs"
					aria-hidden="true"
				>
					<div class="flex items-center gap-3.5 h-8.5 px-3.5 border-b border-white/7 text-[#8b949e] text-[11.5px]">
						<span
							class="inline-flex gap-1.5 [&>i]:size-2.5 [&>i]:rounded-full [&>i]:bg-white/20 [&>i]:transition-colors group-hover:[&>i:nth-child(1)]:bg-[#ff5f57] group-hover:[&>i:nth-child(2)]:bg-[#febc2e] group-hover:[&>i:nth-child(3)]:bg-[#28c840]"
						>
							<i></i>
							<i></i>
							<i></i>
						</span>
						<code>~/github/rubenbupe</code>
					</div>
					<pre
						class="m-0 p-5 leading-[1.8] whitespace-pre-wrap font-mono"><span class="text-[#7ee787]">$</span> ls -1 --sort=fun
<span class="text-[#79c0ff]">smartir-mqtt-climate-builder/</span>
<span class="text-[#79c0ff]">react-navigation-responsive-tab-navigator/</span>
<span class="text-[#79c0ff]">simple-python-logger/</span>
<span class="text-[#f7f8f8]">twitter-bash/</span>
<span class="text-[#7ee787]">$</span> <span class="inline-block w-2 h-3.75 align-[-2px] bg-[#c9d1d9] animate-blink" /></pre>
				</div>
			</a>
		</div>
	</Section>
</div>
