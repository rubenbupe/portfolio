---
import Section from '../components/Section.astro';
import ConicHeader from '../components/ConicHeader.astro';
import { Icon } from 'astro-icon/components';
import { Particles } from '../components/Particles';
import nameToSpeech from '../assets/name-to-speech.mp3';

const skills = [
	{ title: 'Web development', note: 'React, Astro, performance, SEO' },
	{ title: 'Backend development', note: 'Go, Node, SQL, real-time' },
	{ title: 'Software architecture', note: 'Microservices, event-driven, CQRS, DDD' },
	{ title: 'Mobile development', note: 'React Native, Kotlin, Jetpack Compose' },
	{ title: 'UI/UX design', note: 'Interfaces with care in the details' },
	{ title: 'ML/AI', note: 'Computer vision, OCR pipelines, LLMs' }
];
---

<div class="relative w-full flex flex-col">
	<ConicHeader color="hsla(var(--conic-background))" borderColor="hsla(var(--conic-border))" />
	<div
		class="w-full max-w-160 h-40 relative self-center mask-[radial-gradient(350px_200px_at_top,white_20%,transparent)]"
	>
		<Particles client:visible theme="auto" minSize={0.4} maxSize={1} particleDensity={100} className="w-full h-full" />
	</div>
</div>
<Section id="about" class="relative py-24 min-h-[90vh]" zoomEffect>
	<h2 class="max-w-3xl font-display text-4xl sm:text-5xl md:text-7xl leading-[0.98] tracking-[-0.03em]" data-reveal>
		<span class="font-gradient">A bit about me.</span>
	</h2>

	<div class="grid md:grid-cols-[1.1fr_1fr] gap-12 md:gap-24 mt-16 md:mt-20">
		<div>
			<audio id="name-to-speech-audio" src={nameToSpeech} class="hidden"></audio>
			<p class="text-xl md:text-2xl leading-snug text-foreground/80 tracking-tight" data-reveal>
				Hey there! My name is <button
					onclick="document.getElementById('name-to-speech-audio').play()"
					class="cursor-pointer text-foreground hover:text-primary/60 hover:underline"
					aria-label="Check pronunciation"
					><strong class="font-medium">Rubén Buzón</strong><Icon
						name="tabler:volume-2"
						class="inline transform -translate-y-1 translate-x-px"
					/></button
				> and I'm a software engineer based in Spain. I started programming when I was 14 because I've always loved video
				games and I wanted to know how software was made, and I never stopped.
			</p>
			<p class="mt-5 md:max-w-lg leading-relaxed text-foreground/60 md:text-lg" data-reveal style="--reveal-delay: 1">
				I'm passionate about technology and science in general. I truly believe that technology, specially software, can
				change the world for the better. That's why I'm always looking for new opportunities to work on projects that
				can make a difference, and why I put so much effort, care and passion into my work (like this website!).
			</p>
			<p class="mt-5 md:max-w-lg leading-relaxed text-foreground/60 md:text-lg" data-reveal style="--reveal-delay: 2">
				I would describe myself as a full-stack developer with experience in a wide range of technologies, but I'm
				always looking to learn new things and improve my skills.
			</p>
		</div>

		<ol class="self-start border-t" data-reveal style="--reveal-delay: 2">
			{
				skills.map(skill => (
					<li class="relative group grid grid-cols-[1fr_auto] items-baseline gap-4 px-1 py-4 border-b transition-[padding] duration-300 ease-out hover:pl-8 before:content-[''] before:absolute before:inset-0 before:opacity-0 before:transition-opacity before:bg-linear-to-r before:from-foreground/5 before:to-transparent hover:before:opacity-100">
						<span class="relative flex items-center font-display text-xl tracking-tight whitespace-nowrap">
							<Icon
								name="tabler:arrow-right"
								class="absolute left-0 -translate-x-7 opacity-0 group-hover:opacity-100 group-hover:-translate-x-6 transition-all duration-300 ease-out"
							/>
							{skill.title}
						</span>
						<span class="text-xs text-foreground/60 text-right max-md:hidden">{skill.note}</span>
					</li>
				))
			}
		</ol>
	</div>
</Section>
